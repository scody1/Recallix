# Node dependencies & build outputs
node_modules/
dist/
dist-ssr/
*.local

# Python caches & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
!.env.example

# Local SQLite databases & journals
*.db
*.db-journal
*.db-wal
*.db-shm
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*test*.db
data/*archive*
*archive*.db

# User data, personal PDFs, uploads & backups
data/uploads/*
!data/uploads/.gitkeep
data/backups/*
!data/backups/.gitkeep
data/assets/pages/*
!data/assets/pages/.gitkeep
data/**/*.pdf
data/*.pdf

# Build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Editor & OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
